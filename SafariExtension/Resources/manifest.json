{
  "manifest_version": 3,
  "name": "Form Fill",
  "description": "端末内に保護した姓名・住所を、認証して入力欄に合わせて補完します。",
  "version": "0.1.0",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging",
    "clipboardWrite"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": false
  },
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Form Fill",
    "default_icon": {
      "32": "icon-32.png",
      "64": "icon-64.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
